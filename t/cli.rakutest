use v6.e.PREVIEW;
use Test;

my $root  = $?FILE.IO.parent(2);
my $messy = $root.add('examples/messy.raku').relative($root);
my $tidy  = $root.add('examples/tidy.raku').relative($root);

sub rakufmt(*@args, :$lib --> Hash:D) {
    my $proc = run $*EXECUTABLE, '-I' ~ $root, |('-I' ~ $_ with $lib), $root.add('bin/rakufmt'), |@args,
      :cwd($root), :out, :err;
    my $out = $proc.out.slurp(:close);
    my $err = $proc.err.slurp(:close);
    %(:$out, :$err, :exitcode($proc.exitcode))
}

subtest 'options can follow the paths' => {
    my %r = rakufmt($messy, '--check');
    is %r<exitcode>, 1, 'a changed file exits 1';
    is %r<out>, "$messy would be reformatted\n", '--check after the path still checks';
}

subtest '-I takes its directory as the next argument' => {
    my %r = rakufmt('-I', 'lib', '--check', $tidy);
    is %r<exitcode>, 0, 'a tidy file exits 0';
    is %r<out>, '', 'lib is not treated as a path to format';
}

subtest 'a number option takes the next argument as its value' => {
    my $file = $*TMPDIR.add("rakufmt-indent-$*PID.raku");
    $file.spurt("if True \{\nsay 1;\n}\n");
    END $file.unlink;
    my %r = rakufmt('--indent', '2', $file);
    is %r<out>, "if True \{\n  say 1;\n}\n", '--indent 2 indents by two spaces';
    %r = rakufmt('--indent', $file);
    is %r<exitcode>, 2, '--indent without a value is a usage error';
}

subtest 'modes do not combine' => {
    my $copy = $*TMPDIR.add("rakufmt-modes-$*PID.raku");
    $copy.spurt($root.add($messy).slurp);
    END $copy.unlink;
    my %r = rakufmt('--check', '--write', $copy);
    is %r<exitcode>, 2, '--check with --write is a usage error';
    ok %r<err>.starts-with('Usage:'), '--check with --write prints the usage';
    is $copy.slurp, $root.add($messy).slurp, '--check with --write does not rewrite the file';
}

subtest 'options a mode does not use are refused' => {
    my %r = rakufmt('--comments', '--indent=2', $messy);
    is %r<exitcode>, 2, '--comments with --indent is a usage error';
}

subtest 'rules are named on the command line' => {
    my %r = rakufmt('--enable-rule', 'single-quotes', '--disable-rule=indent', '--disable-rule=align-comments', '--check', $tidy);
    is %r<exitcode>, 1, '--enable-rule with a separate value turns on a rule';
    is %r<out>, "$tidy would be reformatted\n", 'the enabled rule changes the tidy example';

    %r = rakufmt('--enable-rule=nope', $messy);
    is %r<exitcode>, 2, 'an unknown rule is a usage error';
    ok %r<err>.starts-with('Usage:'), 'an unknown rule prints the usage';

    %r = rakufmt('--enable-rule=single-quotes', '--check', $tidy, $messy);
    is %r<exitcode>, 1, 'options reach the process each of several files is formatted by';
    is %r<out>, "$tidy would be reformatted\n$messy would be reformatted\n", 'every file of several is formatted';
}

subtest 'rules from modules' => {
    my $lib = $root.add('t/lib').absolute;
    my %r = rakufmt('--list-rules', '--rule-module=SpacingRules', :$lib);
    is %r<out>.lines.head(2).map(*.words.head).List, <paren-spacing semicolon-spacing>,
      '--list-rules shows the rules of a module first';

    my $spaced = $*TMPDIR.add("rakufmt-spaced-$*PID.raku").absolute;
    my $tight  = $*TMPDIR.add("rakufmt-tight-$*PID.raku").absolute;
    $spaced.IO.spurt("say 1 ;\n");
    $tight.IO.spurt("say(1);\n");
    END .IO.unlink for $spaced, $tight;
    %r = rakufmt('--check', '--rule-module', 'SpacingRules', '--enable-rule=semicolon-spacing', $spaced, $tight, :$lib);
    is %r<out>, "$spaced would be reformatted\n", 'a rule of a module can be enabled, in the process each of several files is formatted by';

    $spaced.IO.spurt("say( 1 );\n");
    %r = rakufmt('--check', '--rule-module=SpacingRules', $spaced, :$lib);
    is %r<exitcode>, 1, 'a rule of a module that is on by default runs';
    %r = rakufmt('--check', '--rule-module=SpacingRules', '--disable-rule=paren-spacing', $spaced, :$lib);
    is %r<exitcode>, 0, 'a rule of a module can be disabled';

    %r = rakufmt('--check', '--enable-rule=semicolon-spacing', $tidy, :$lib);
    is %r<exitcode>, 2, 'the rules of a module that is not given are not available';

    %r = rakufmt('--list-rules', '--rule-module=SecondIndent', :$lib);
    isnt %r<exitcode>, 0, 'a module with a rule of the same name as another fails';
    ok %r<err>.contains("rakufmt: more than one rule is named 'indent'"), 'the rule name used twice is named';
}

subtest '--help' => {
    my %r = rakufmt('--help');
    is %r<exitcode>, 0, '--help exits 0';
    ok %r<out>.contains('List the files that would change'), '--help describes the modes';
}

done-testing;
