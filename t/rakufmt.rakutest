use v6.e.PREVIEW;
use Test;
use experimental :rakuast;
use RakuFmt;
use RakuFmt::Source;
use RakuFmt::Rules;

sub fmt(Str $text --> Str:D) { RakuFmt.new.format($text).formatted }

my $messy = $?FILE.IO.parent(2).add('examples/messy.raku').slurp;
my $once = fmt($messy);
is $once, $?FILE.IO.parent(2).add('examples/tidy.raku').slurp, 'the example is reformatted as shown in examples/tidy.raku';
is fmt($once), $once, 'formatting is idempotent';
is RakuFmt::Source.new(:text($once)).comments.elems, RakuFmt::Source.new(:text($messy)).comments.elems,
  'every comment is still there';

my class BreakIt does RakuFmt::Rule {
    method name(--> Str:D) { 'break-it' }
    method description(--> Str:D) { 'turns + into -' }
    method edits($src, % --> Iterable:D) {
        $src.nodes-of(RakuAST::Infix).grep({ $src.text-of($_) eq '+' })
          .map({ self.edit(.origin.from, .origin.to, '-', 'sabotage') })
    }
}
throws-like { RakuFmt.new(:rules(BreakIt.new)).format("say 1 + 2;\n") },
  X::RakuFmt::MeaningChanged, 'a rule that changes the meaning of the code is refused';

done-testing;
